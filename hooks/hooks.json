{
  "universal-frontier-runtime": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python hooks/pre_invocation.py",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/pre_tool.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/post_tool.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python hooks/stop_gate.py",
        "timeout": 10
      }
    ]
  }
}
